{
  "name": "parts-maker",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd server && python3 -m uvicorn main:app --host 127.0.0.1 --port 8787",
    "dev:all": "npx --yes concurrently -k -n api,web -c teal,amber \"npm run dev:api\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
